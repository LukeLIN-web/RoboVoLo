        float3 xformOp:scale = (0.4843457, 0.4843457, 0.4843457)
        double3 xformOp:translate = (0.6238285899162292, -0.08155983686447144, 0.003994554281234741)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]

        over "beige_office_compost_can"
        {
            over "compost_label_decal"
            {
                float3 xformOp:rotateXYZ = (92.93691, 0.13484216, -0.045058724)
                float3 xformOp:scale = (1, 1, 1)
                double3 xformOp:translate = (0.000023399268322787936, -0.12570611840383128, 0.26632330509465263)
                uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateXYZ", "xformOp:scale"]

                over "compost_label_decal_mesh"
                {
                    quatf xformOp:orient = (0.99998915, -0.004648323, 8.483913e-7, 0.00023099672)
                    float3 xformOp:scale = (1, 1, 1)
                    double3 xformOp:translate = (-5.551115123125783e-17, 2.7755575615628914e-16, 0)
                    uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]
                }
            }
        }

        over "CollisionProxies" (
            active = false
        )
        {
            over "wall_pos_x"
            {
                quatf xformOp:orient = (1, 0, 0, 0)
                float3 xformOp:scale = (0.006, 0.15, 0.2500006)
                double3 xformOp:translate = (0.16831347317136625, -0.001252423784771084, 0.2500001303350354)
                uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]
            }

            over "wall_neg_x"
            {
                quatf xformOp:orient = (1, 0, 0, 0)
                float3 xformOp:scale = (0.006, 0.15, 0.2500006)
                double3 xformOp:translate = (-0.16051384526673768, 0.0016327180753277215, 0.2500012122771799)
                uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]
            }

            over "wall_pos_y"
            {
                quatf xformOp:orient = (1, 0, 0, 0)
                float3 xformOp:scale = (0.2, 0.006, 0.2500006)
                double3 xformOp:translate = (0.0011527802662822384, 0.12035710741535044, 0.25000012073134836)
                uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]
            }

            over "wall_neg_y"
            {
                quatf xformOp:orient = (1, 0, 0, 0)
                float3 xformOp:scale = (0.2, 0.006, 0.2500006)
                double3 xformOp:translate = (-0.0013360694148046859, -0.11659794725547545, 0.2500011554711589)
                uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]
            }
        }
    }

