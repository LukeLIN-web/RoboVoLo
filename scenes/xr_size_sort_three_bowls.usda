    def "lemon_02" (
        prepend payload = @../../objects/fruits_veggies/lemon2.usd@
    )
    {
        vector3f physics:angularVelocity
        vector3f physics:velocity
        quatf xformOp:orient = (0.734695, 0.027876116, -0.04765197, 0.6761475)
        float3 xformOp:scale = (1.217783, 1.217783, 1.217783)
        double3 xformOp:translate = (0.399995356798172, -0.00007581221871078014, 0.0027736183255910873)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]
    }

    def "orange_01" (
        prepend payload = @../../objects/fruits_veggies/orange1.usd@
    )
    {
        vector3f physics:angularVelocity
        vector3f physics:velocity
        quatf xformOp:orient = (0.75136626, -0.00043742405, -0.51233006, 0.4158924)
        float3 xformOp:scale = (1, 1, 1)
        double3 xformOp:translate = (0.3980158269405365, -0.17844313383102417, 0.01835067942738533)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]
    }

    def PhysicsScene "PhysicsScene" (
        prepend apiSchemas = ["PhysxSceneAPI"]
    )
    {
        uniform token physxScene:broadphaseType = "MBP"
        bool physxScene:enableCCD = 1
        bool physxScene:enableGPUDynamics = 0
        uniform uint physxScene:minPositionIterationCount = 64
        uniform token physxScene:solverType = "PGS"
        uint physxScene:timeStepsPerSecond = 240
    }
}

