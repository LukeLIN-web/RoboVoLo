        float3 xformOp:scale = (1, 1, 1)
        double3 xformOp:translate = (0.6500152349472046, -0.2826875150203705, 0.002932406961917877)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]
    }

    def "lychee01" (
        prepend payload = @../../objects/fruits_veggies/lychee.usd@
    )
    {
        vector3f physics:angularVelocity
        vector3f physics:velocity
        quatf xformOp:orient = (0.25552064, -0.53219396, -0.36359668, 0.72060823)
        float3 xformOp:scale = (0.944843, 0.944843, 0.944843)
