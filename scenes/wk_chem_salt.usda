    }

    def "element_s" (
        prepend payload = @../../objects/chemistry_cubes/element_016_s.usda@
    )
    {
        vector3f physics:angularVelocity
        vector3f physics:velocity
        quatf xformOp:orient = (-0.70703596, 0.011924669, -0.00022384524, 0.707077)
        float3 xformOp:scale = (1, 1, 1)
        double3 xformOp:translate = (0.5449326038360596, 0.2625342011451721, 0.0279930979013443)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]
    }

    def PhysicsScene "PhysicsScene" (
        prepend apiSchemas = ["PhysxSceneAPI"]
    )
    {
        uniform token physxScene:broadphaseType = "MBP"
        bool physxScene:enableCCD = 1
        bool physxScene:enableGPUDynamics = 0
        uniform uint physxScene:minPositionIterationCount = 64
        uniform token physxScene:solverType = "PGS"
        uint physxScene:timeStepsPerSecond = 240
    }
