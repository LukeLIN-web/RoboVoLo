        float3 xformOp:scale = (1, 1, 1)
        double3 xformOp:translate = (0.45408380031585693, 0.12143305689096451, 0.02799372561275959)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]
    }

    def "element_au" (
        prepend payload = @../../objects/chemistry_cubes/element_079_au.usda@
    )
    {
        vector3f physics:angularVelocity
        vector3f physics:velocity
        quatf xformOp:orient = (-0.7070362, 0.012308806, -0.00020854175, 0.7070702)
        float3 xformOp:scale = (1, 1, 1)
        double3 xformOp:translate = (0.6161823868751526, 0.10819303244352341, 0.027995282784104347)
