        quatf xformOp:orient = (0.9031078, -0.00015322259, 0.00025809323, 0.42941374)
        float3 xformOp:scale = (1, 1, 1)
        double3 xformOp:translate = (0.4509109854698181, -0.25001001358032227, 0.002940356731414795)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]
    }

    def "lemon_02" (
        prepend payload = @../../objects/fruits_veggies/lemon2.usd@
    )
    {
        vector3f physics:angularVelocity
        vector3f physics:velocity
        quatf xformOp:orient = (0.30969873, 0.047414, -0.025404101, 0.949312)
        float3 xformOp:scale = (1, 1, 1)
        double3 xformOp:translate = (0.6961362957954407, 0.24994735419750214, 0.0028069093823432922)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]
    }

    def "orange_01" (
        prepend payload = @../../objects/fruits_veggies/orange1.usd@
    )
    {
        vector3f physics:angularVelocity
        vector3f physics:velocity
        quatf xformOp:orient = (0.8263568, -0.398601, -0.013575107, -0.39757687)
        float3 xformOp:scale = (1, 1, 1)
        double3 xformOp:translate = (0.6908329129219055, 0.0013750139623880386, 0.011009402573108673)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]
    }

    def "lime01" (
        prepend payload = @../../objects/fruits_veggies/lime.usd@
    )
    {
        vector3f physics:angularVelocity
        vector3f physics:velocity
        quatf xformOp:orient = (0.691816, -0.38280076, 0.37716702, -0.48228547)
        float3 xformOp:scale = (1, 1, 1)
        double3 xformOp:translate = (0.6942209601402283, -0.24784579873085022, 0.019321275874972343)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]
    }

    def PhysicsScene "PhysicsScene" (
        prepend apiSchemas = ["PhysxSceneAPI"]
    )
    {
        uniform token physxScene:broadphaseType = "MBP"
        bool physxScene:enableCCD = 1
        bool physxScene:enableGPUDynamics = 0
        uniform uint physxScene:minPositionIterationCount = 64
        uniform token physxScene:solverType = "PGS"
        uint physxScene:timeStepsPerSecond = 240
    }
}

