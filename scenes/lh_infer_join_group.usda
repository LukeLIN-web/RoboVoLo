        float3 xformOp:scale = (1, 1, 1)
        double3 xformOp:translate = (0.4493754506111145, 0.00015114841517060995, 0.007363572716712952)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]
    }

    def "lime01" (
        prepend payload = @../../objects/fruits_veggies/lime.usd@
    )
    {
        vector3f physics:angularVelocity
        vector3f physics:velocity
        quatf xformOp:orient = (0.6932779, -0.48677227, -0.22727638, 0.480379)
        float3 xformOp:scale = (1, 1, 1)
        double3 xformOp:translate = (0.6120933890342712, 0.16425307095050812, 0.019314542412757874)
