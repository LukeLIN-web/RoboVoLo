    {
        vector3f physics:angularVelocity
        vector3f physics:velocity
        quatf xformOp:orient = (-0.699792, 0.059412062, -0.05087102, 0.7100517)
        float3 xformOp:scale = (1, 1, 1)
        double3 xformOp:translate = (0.4644264280796051, -0.15085500478744507, 0.04198065772652626)
