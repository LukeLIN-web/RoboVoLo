    def "lime01" (
        prepend payload = @../../objects/fruits_veggies/lime.usd@
    )
    {
        vector3f physics:angularVelocity
        vector3f physics:velocity
        quatf xformOp:orient = (0.16666837, -0.18994759, -0.26933527, 0.92930084)
        float3 xformOp:scale = (1, 1, 1)
        double3 xformOp:translate = (0.45084595680236816, -0.20053939521312714, 0.009376198053359985)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]
