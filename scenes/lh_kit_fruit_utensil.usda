        float3 xformOp:scale = (1, 1, 1)
        double3 xformOp:translate = (0.5502182841300964, 0.023282291367650032, 0.04509744420647621)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]
    }

    def "bowl" (
        prepend payload = @../../objects/ycb/bowl2.usd@
    )
    {
        vector3f physics:angularVelocity
        vector3f physics:velocity
        quatf xformOp:orient = (-0.45180753, 0.00048104534, -0.00010922295, 0.8921153)
        float3 xformOp:scale = (1.3, 1.3, 1.3)
        double3 xformOp:translate = (0.45020338892936707, -0.20012065768241882, 0.038520921021699905)
