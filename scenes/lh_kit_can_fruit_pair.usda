        quatf xformOp:orient = (0.67646015, -0.19256477, -0.48620835, 0.5185768)
        float3 xformOp:scale = (1, 1, 1)
        double3 xformOp:translate = (0.5232368111610413, 0.14664852619171143, 0.022967061027884483)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]
    }

    def "serving_bowl" (
        prepend payload = @../../objects/vomp/serving_bowl/serving_bowl.usd@
    )
    {
        vector3f physics:angularVelocity
        vector3f physics:velocity
        quatf xformOp:orient = (0.73994166, -0.00048841885, 0.000083516104, 0.67267084)
        float3 xformOp:scale = (1.2, 1.2, 1)
        double3 xformOp:translate = (0.4501331150531769, -0.20010332763195038, 0.003310650587081909)
