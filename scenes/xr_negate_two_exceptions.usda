        vector3f physics:velocity
        quatf xformOp:orient = (-0.595088, 1.555743e-7, -2.0278111e-7, 0.8036606)
        float3 xformOp:scale = (1, 1, 1)
        double3 xformOp:translate = (0.5995256304740906, -0.0806402862071991, 0.026295658200979233)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]
    }

    def "tuna_can" (
        prepend payload = @../../objects/ycb/tuna_can.usd@
    )
    {
        vector3f physics:angularVelocity
        vector3f physics:velocity
        quatf xformOp:orient = (0.0349849, 0.0012244135, 0.0005679265, 0.9993869)
        float3 xformOp:scale = (1, 1, 1)
        double3 xformOp:translate = (0.6350454092025757, -0.273528128862381, 0.019601354375481606)
