        prepend payload = @../../objects/fruits_veggies/orange1.usd@
    )
    {
        vector3f physics:angularVelocity
        vector3f physics:velocity
        quatf xformOp:orient = (0.8588296, -0.24816398, -0.44813615, 0.0005345829)
        float3 xformOp:scale = (1, 1, 1)
        double3 xformOp:translate = (0.4535805881023407, 0.2094433307647705, 0.018345611169934273)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]
    }

    def "lemon_02" (
        prepend payload = @../../objects/fruits_veggies/lemon2.usd@
    )
    {
        vector3f physics:angularVelocity
        vector3f physics:velocity
        quatf xformOp:orient = (-0.70354736, 0.045508284, 0.031043643, 0.70851)
        float3 xformOp:scale = (1, 1, 1)
        double3 xformOp:translate = (0.46637094020843506, -0.20498795807361603, 0.002819649875164032)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]
