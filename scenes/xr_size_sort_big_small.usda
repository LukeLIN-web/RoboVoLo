        float3 xformOp:scale = (1.35, 1.35, 1.35)
        double3 xformOp:translate = (0.6368170976638794, -0.19890262186527252, 0.0026262812316417694)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]
