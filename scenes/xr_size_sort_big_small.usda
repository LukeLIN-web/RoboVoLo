        double3 xformOp:translate = (0.6403704285621643, 0.06960970908403397, 0.002812465652823448)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]
    }

    def "lychee01" (
        prepend payload = @../../objects/fruits_veggies/lychee.usd@
    )
    {
        vector3f physics:angularVelocity
