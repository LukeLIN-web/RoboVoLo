    {
        vector3f physics:angularVelocity
        vector3f physics:velocity
        quatf xformOp:orient = (0.96638286, 0.0013332536, -0.008110027, 0.2569759)
        float3 xformOp:scale = (1, 1, 1)
        double3 xformOp:translate = (0.7202522158622742, 0.3497074544429779, 0.011508436873555183)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]
    }

    def Xform "spoon_1" (
        prepend payload = @../../objects/handal/spoon_1.usd@
    )
    {
        vector3f physics:angularVelocity
        vector3f physics:velocity
        quatf xformOp:orient = (0.38221753, -0.009698994, 0.0029019192, 0.9240169)
        float3 xformOp:scale = (1, 1, 1)
        double3 xformOp:translate = (0.7208372950553894, 0.2093985676765442, 0.013912726193666458)
