    def Xform "spoon_2" (
        prepend payload = @../../objects/handal/spoon_2.usd@
    )
    {
        vector3f physics:angularVelocity
        vector3f physics:velocity
        quatf xformOp:orient = (-0.2535402, -0.00069029303, -0.00048139525, 0.9673245)
        float3 xformOp:scale = (1, 1, 1)
        double3 xformOp:translate = (0.720308244228363, 0.06963174790143967, 0.008366440422832966)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]
    }

    def Xform "spoon_3" (
        prepend payload = @../../objects/handal/spoon.usd@
    )
    {
        vector3f physics:angularVelocity
        vector3f physics:velocity
        quatf xformOp:orient = (0.7947113, 0.0043327697, -0.0069843214, 0.606932)
        float3 xformOp:scale = (1, 1, 1)
        double3 xformOp:translate = (0.6001879572868347, 0.3492419421672821, 0.011508502066135406)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]
    }

    def Xform "spoon_4" (
        prepend payload = @../../objects/handal/spoon_1.usd@
    )
    {
        vector3f physics:angularVelocity
        vector3f physics:velocity
        quatf xformOp:orient = (0.86569375, 0.0041071624, 0.00914607, -0.5004736)
        float3 xformOp:scale = (1, 1, 1)
        double3 xformOp:translate = (0.6006664633750916, 0.20936791598796844, 0.013909311965107918)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]
    }

    def PhysicsScene "PhysicsScene" (
        prepend apiSchemas = ["PhysxSceneAPI"]
    )
    {
        uniform token physxScene:broadphaseType = "MBP"
        bool physxScene:enableCCD = 1
        bool physxScene:enableGPUDynamics = 0
        uniform uint physxScene:minPositionIterationCount = 64
        uniform token physxScene:solverType = "PGS"
        uint physxScene:timeStepsPerSecond = 240
    }
