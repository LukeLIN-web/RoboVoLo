    def "open_cardboard_box_002" (
        prepend payload = @../../objects/simready/boxes_packaging/open_cardboard_box_002/open_cardboard_box_002.usda@
    )
    {
        vector3f physics:angularVelocity
        vector3f physics:velocity
        quatf xformOp:orient = (-0.50373155, 0.00017068473, 0.00028855162, 0.8638602)
        float3 xformOp:scale = (0.4, 0.4, 0.4)
        double3 xformOp:translate = (0.625038206577301, -0.19384992122650146, 0.003918513655662537)
