        quatf xformOp:orient = (0.234295, 0.0010373621, -0.0020456596, 0.97216284)
        float3 xformOp:scale = (1, 1, 1)
        double3 xformOp:translate = (0.5742543935775757, 0.10513581335544586, 0.03185858950018883)
