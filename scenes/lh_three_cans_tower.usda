    }

    def "chocolate_pudding" (
        prepend payload = @../../objects/ycb/chocolate_pudding.usd@
    )
    {
        vector3f physics:angularVelocity
        vector3f physics:velocity
        quatf xformOp:orient = (0.25485665, -0.0020979734, -0.006060976, 0.96695757)
        float3 xformOp:scale = (1, 1, 1)
        double3 xformOp:translate = (0.5537111163139343, -0.2328478842973709, 0.022187964990735054)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]
    }

    def "butter" (
        prepend payload = @../../objects/hope/butter.usd@
    )
    {
        vector3f physics:angularVelocity
        vector3f physics:velocity
        quatf xformOp:orient = (-0.113996185, 0.001991107, -0.0021910039, 0.99347675)
        float3 xformOp:scale = (1, 1, 1)
        double3 xformOp:translate = (0.6817067861557007, 0.09000742435455322, 0.02960255555808544)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]
