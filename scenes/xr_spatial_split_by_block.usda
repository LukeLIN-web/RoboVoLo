        quatf xformOp:orient = (0.95662516, -0.025134593, -0.04902147, -0.2860654)
        float3 xformOp:scale = (1, 1, 1)
        double3 xformOp:translate = (0.4301225543022156, -0.055671170353889465, 0.002819683402776718)
