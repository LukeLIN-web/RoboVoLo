        quatf xformOp:orient = (-0.24777994, 0.79215544, -0.38269454, -0.4057582)
        float3 xformOp:scale = (1, 1, 1)
        double3 xformOp:translate = (0.6758732199668884, -0.059813015162944794, 0.035959672182798386)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]
    }

    def "serving_bowl" (
        prepend payload = @../../objects/vomp/serving_bowl/serving_bowl.usd@
    )
    {
        vector3f physics:angularVelocity
        vector3f physics:velocity
        quatf xformOp:orient = (0.99212664, -0.00003948072, 0.00040826987, -0.12523809)
        float3 xformOp:scale = (1, 1, 1)
        double3 xformOp:translate = (0.5801568627357483, -0.2703171968460083, 0.0032420437783002853)
