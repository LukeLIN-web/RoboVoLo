        float3 xformOp:scale = (1, 1, 1)
        double3 xformOp:translate = (0.6495999097824097, 0.026312705129384995, 0.01933477818965912)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]
    }

    def "tuna_can" (
        prepend payload = @../../objects/ycb/tuna_can.usd@
    )
    {
        vector3f physics:angularVelocity
        vector3f physics:velocity
        quatf xformOp:orient = (0.862651, -0.0002970658, -0.0008699125, -0.50579876)
        float3 xformOp:scale = (1, 1, 1)
        double3 xformOp:translate = (0.6084191799163818, -0.15183821320533752, 0.01954241655766964)
