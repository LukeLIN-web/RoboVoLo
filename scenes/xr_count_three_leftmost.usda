        prepend payload = @../../objects/ycb/spam_can.usd@
    )
    {
        vector3f physics:angularVelocity
        vector3f physics:velocity
        quatf xformOp:orient = (0.9918944, -0.0019045279, -0.00047802486, -0.12704937)
        float3 xformOp:scale = (1, 1, 1)
        double3 xformOp:translate = (0.537727415561676, -0.3488830029964447, 0.044558655470609665)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]
