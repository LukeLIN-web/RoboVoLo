    def "bin_a02" (
        prepend payload = @../../objects/vomp/bin_a02/bin_a02.usd@
    )
    {
        vector3f physics:angularVelocity
        vector3f physics:velocity
        quatf xformOp:orient = (0.09685966, 0.0022877885, -0.0006197292, 0.9952952)
        float3 xformOp:scale = (1.4, 1.4, 0.8)
        double3 xformOp:translate = (0.3288668692111969, 0.004586140625178814, 0.0028710011392831802)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]
