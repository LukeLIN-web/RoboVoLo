# Preserve imported asset source formatting and store binary/large assets in Git LFS.
assets/** -whitespace
assets/**/*.blend filter=lfs diff=lfs merge=lfs -text
assets/**/*.exr filter=lfs diff=lfs merge=lfs -text
assets/**/*.png filter=lfs diff=lfs merge=lfs -text
assets/**/*.usd filter=lfs diff=lfs merge=lfs -text
assets/**/*.usda filter=lfs diff=lfs merge=lfs -text
assets/**/*.usdc filter=lfs diff=lfs merge=lfs -text
assets/**/*.usdz filter=lfs diff=lfs merge=lfs -text
